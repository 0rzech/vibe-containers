#!/usr/bin/env bash

set -euo pipefail

work_dir="$(realpath .)"
config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/vibe-containers"
prefix_file="${config_dir}/work-dir-prefix.list"
drop_ins_dir="${config_dir}/drop-ins"
bin_drop_ins_dir="${drop_ins_dir}/bin"

if [[ -f "${prefix_file}" ]]; then
  readarray -t prefixes < "${prefix_file}"

  for prefix in "${prefixes[@]}"; do
    if [[ "${prefix}" =~ ^[[:space:]]*(#|$) ]]; then
      continue
    fi

    if [[ "${work_dir}" == "${prefix}"* ]]; then
      prefix_match=true
      break
    fi
  done

  if [[ "${prefix_match:-false}" == false ]]; then
    echo >&2 "Working directory absolute path '${work_dir}'" \
      "does not start with any prefix defined in '${prefix_file}'"
    exit 1
  fi
fi

dir_name="$(basename "${work_dir}")"
container_name="vibe-${dir_name//[^a-zA-Z0-9.-]/-}-${RANDOM}"
vibe_home="${VIBE_HOME:-${HOME}/.vibe}"

volumes=(
  --volume "${vibe_home}:${vibe_home}:z"
  --volume "${work_dir}:${work_dir}:z"
)

if [[ -d "${bin_drop_ins_dir}" ]]; then
  volumes+=( --volume "${bin_drop_ins_dir}:/usr/local/bin:ro,z" )
fi

exec podman run \
  --rm \
  --tty \
  --interactive \
  --init \
  --cap-drop all \
  --security-opt no-new-privileges \
  --userns keep-id \
  --log-driver none \
  --workdir "${work_dir}" \
  "${volumes[@]}" \
  --env TERM \
  --env COLORTERM \
  --hostname "${container_name}" \
  --name "${container_name}" \
  --entrypoint "${ENTRYPOINT:-vibe}" \
  localhost/vibe-sandbox \
    "${@}"
